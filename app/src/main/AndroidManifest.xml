<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cấu hình ứng dụng: tắt sao lưu, chọn biểu tượng, tên và theme khởi động. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_wallet"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QLCT">
        <!-- Activity đầu vào; exported cho phép launcher của hệ thống mở ứng dụng. -->
        <activity android:name=".MainActivity" android:exported="true">
            <!-- MAIN + LAUNCHER đưa ứng dụng vào danh sách ứng dụng có thể khởi chạy. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
